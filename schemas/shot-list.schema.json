{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Filmmaking Bible shot list",
  "type": "object",
  "required": [
    "title",
    "duration_seconds",
    "aspect_ratio",
    "fps",
    "shots",
    "notice"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aspect_ratio": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "start_seconds",
          "end_seconds",
          "shot_size",
          "angle",
          "movement",
          "narrative_purpose",
          "audio",
          "status",
          "selected_take"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^S[0-9]{2,}$"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "shot_size": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "movement": {
            "type": "string"
          },
          "narrative_purpose": {
            "type": "string"
          },
          "audio": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "generated",
              "reviewed",
              "selected"
            ]
          },
          "selected_take": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "notice": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
