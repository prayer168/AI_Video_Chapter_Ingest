{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Video Bible publication image record",
  "type": "object",
  "required": [
    "id",
    "media_kind",
    "figure_id",
    "path",
    "description",
    "paragraph_reference",
    "teaching_purpose",
    "research_sources",
    "original_prompt_or_method",
    "tool_name",
    "tool_version",
    "production_log",
    "rights_risk_review",
    "caption_zh_tw",
    "caption_en",
    "review_status",
    "approval_status",
    "publication_targets",
    "creator",
    "license",
    "permission",
    "attribution",
    "chapter_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "media_kind": {
      "const": "image"
    },
    "figure_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "paragraph_reference": {
      "type": "string",
      "minLength": 1
    },
    "teaching_purpose": {
      "type": "string",
      "minLength": 1
    },
    "research_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "accessed",
          "purpose"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "original_prompt_or_method": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "production_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date",
          "change"
        ],
        "properties": {
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "rights_risk_review": {
      "type": "object",
      "required": [
        "status",
        "checked_at",
        "reviewer",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewer": {
          "type": "string"
        },
        "findings": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "caption_zh_tw": {
      "type": "string",
      "minLength": 1
    },
    "caption_en": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "object",
      "required": [
        "technical",
        "quality",
        "rights",
        "final"
      ],
      "properties": {
        "technical": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "quality": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "rights": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "final": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "approval_status": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "publication_targets": {
      "type": "object",
      "required": [
        "zh-TW-book",
        "en-book",
        "zh-TW-site",
        "en-site"
      ],
      "properties": {
        "zh-TW-book": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "en-book": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "zh-TW-site": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "en-site": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "creator": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "permission": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "chapter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
