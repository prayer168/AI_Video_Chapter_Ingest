{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Filmmaking Bible chapter metadata",
  "type": "object",
  "required": [
    "id",
    "part",
    "chapter",
    "title",
    "slug",
    "status",
    "updated",
    "locale",
    "authors",
    "reviewers",
    "sources",
    "terms",
    "related_chapters",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[0-9]{2}$"
    },
    "part": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "planned",
        "draft",
        "review",
        "verified"
      ]
    },
    "review_stage": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "locale": {
      "const": "zh-TW"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "related_chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[0-9]{2}$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_pack": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
